[Unit]
Description=RadRelay Pipeline Daemon
After=network.target

[Service]
Type=simple
User=svcrun
Group=svcrun
WorkingDirectory=/opt/radrelay
Environment=RADRELAY_CONFIG=/etc/radrelay/config.yaml
ExecStart=/opt/radrelay/venv/bin/python -m radrelay.daemon
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/radrelay /var/log/radrelay /etc/radrelay

[Install]
WantedBy=multi-user.target